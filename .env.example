# ═══════════════════════════════════════════════════════════════
# Let-S APK Builder — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production
PUBLIC_URL=https://lets-apk-builder.onrender.com
CORS_ORIGINS=https://letssecuredo.github.io

# ─── GitHub ─────────────────────────────────────────────────────
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN
GITHUB_REPO=letssecuredo/lets-apk-builder
GITHUB_WORKFLOW_FILE=build-apk.yml
GITHUB_REF=main

# ─── Firebase (Firestore ONLY — no Storage) ─────────────────────
FIREBASE_PROJECT_ID=lets-apk-builder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lets-apk-builder.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ❌ FIREBASE_STORAGE_BUCKET removed — not used

# ─── Webhook security ───────────────────────────────────────────
WEBHOOK_SECRET=REPLACE_WITH_128_HEX_CHARS

# ─── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_BUILD_MAX=5
RATE_LIMIT_API_MAX=100

# ─── Optional JWT ───────────────────────────────────────────────
JWT_ENABLED=false
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info

# Build queue
# Queue lease is slightly longer than the GitHub Actions job timeout.
BUILD_QUEUE_LEASE_MS=2100000
BUILD_QUEUE_POLL_MS=15000

# ─── Step 12 Production hardening ──────────────────────────────
# Optional separate secret for worker-only internal config endpoints.
# If omitted, WEBHOOK_SECRET is used for backward compatibility.
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_128_HEX_CHARS
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_INTERNAL_MAX=120
BODY_LIMIT=10mb
REQUEST_TIMEOUT_MS=30000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEPALIVE_TIMEOUT_MS=65000
WEBHOOK_MAX_AGE_MS=300000
CLEANUP_BUILD_INPUTS=true
